# Copy to .env and fill in real values. Never commit the real .env file.

# GHCR image this deployment runs. Built and pushed by
# .github/workflows/docker-build-push.yml -- IMAGE_NAME there is
# `github.repository`, i.e. "<owner>/<repo>", so this is normally:
#   ghcr.io/<owner-or-org>/<repo-name>:latest
GHCR_IMAGE=ghcr.io/your-org/cardbox:latest

# Credentials so this host can `docker pull` that image. GHCR packages
# default to private, so even a public repo's image needs a login here.
# Create a classic Personal Access Token with just the `read:packages`
# scope at https://github.com/settings/tokens -- don't reuse a token with
# broader access for this.
GHCR_USERNAME=your-github-username
GHCR_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Session cookie signing secret -- any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string

# Master key used to encrypt the Gemini API key at rest in Postgres.
# e.g. `openssl rand -hex 32`. Changing this after a key is saved will make
# the stored key undecryptable -- you'd need to re-enter it in the admin UI.
SECRETS_MASTER_KEY=change-me-to-a-long-random-string

# Optional: seeds the first admin user on first startup (only runs when the
# users table is empty). After first login, manage users from /admin.html.
SEED_ADMIN_EMAIL=admin@trivoailabs.com
SEED_ADMIN_PASSWORD=change-me-on-first-login

# Optional fallback if no key is set via the admin UI. Leave blank otherwise --
# once a key is saved in the admin UI it takes priority over this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

NODE_ENV=production
PORT=3000
